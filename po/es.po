#: src/anchor/gui/schedules.py:153
msgid "Schedules are edited freely while they are not running. A running session can only be skipped, up to three times a week."
msgstr "Los horarios se editan libremente mientras no están activos. Una sesión activa solo se puede saltar, hasta 3 veces por semana."

#: src/anchor/gui/schedules.py:198
msgid "This schedule is running now. It can be skipped, not changed."
msgstr "Este horario está activo ahora. Se puede saltar, no cambiar."

