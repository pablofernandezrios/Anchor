#!/usr/bin/make -f

export PYBUILD_NAME=anchor
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_build:
	dh_auto_build
	# The interface's translations (SPEC 14). No gettext tools are needed:
	# tools/po.py writes the .mo files itself.
	python3 tools/po.py compile

override_dh_installsystemd:
	dh_installsystemd --name=anchord
	dh_installsystemd --name=anchor-blockerd

override_dh_auto_test:
	# Only the tests that need neither root, systemd nor a display.
	#
	# Through pybuild rather than calling pytest directly: pybuild runs them
	# against the package it has just built, with PYTHONPATH pointing at it.
	# A bare `python3 -m pytest` here tests nothing, because `anchor` is not
	# importable yet, and the build fails on eighteen collection errors.
	#
	# pybuild builds in a directory holding only the unpacked wheel, and a
	# fifth of the suite reads the repository around it: the shipped lists
	# and categories under data/, the catalogue tools, the packaging files,
	# the source itself for the standard-library guard. They are pointed at
	# the real ones rather than skipped, so the package is tested with the
	# data it will actually install.
	for d in $(CURDIR)/.pybuild/*/build; do \
	  for name in data tools po packaging src; do \
	    ln -sfn $(CURDIR)/$$name $$d/$$name; \
	  done; \
	done
	PYBUILD_TEST_ARGS="-m 'not needs_root and not needs_systemd and not needs_display'" \
	  dh_auto_test
	# And taken away again. dh_auto_install copies this directory wholesale,
	# so a link left behind ships the repository inside the package: the
	# first build put data/, po/, src/, tools/ and packaging/ into
	# /usr/lib/python3/dist-packages as if they were Python packages.
	for d in $(CURDIR)/.pybuild/*/build; do \
	  for name in data tools po packaging src; do \
	    rm -f $$d/$$name; \
	  done; \
	done
