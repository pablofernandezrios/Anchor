#!/bin/sh
# Removal must restore the system, whether or not a session is active
# (SPEC 7.6). Uninstalling is always allowed.
set -e

case "$1" in
  remove|deconfigure)
    # Runtime drop-ins that refuse a manual stop would otherwise keep the
    # services from being stopped during removal (SPEC 5.3).
    rm -f /run/systemd/system/anchord.service.d/anchor-session.conf
    rm -f /run/systemd/system/anchor-blockerd.service.d/anchor-session.conf
    rmdir --ignore-fail-on-non-empty \
      /run/systemd/system/anchord.service.d \
      /run/systemd/system/anchor-blockerd.service.d 2>/dev/null || true
    systemctl daemon-reload || true

    # Undo the DNS configuration, the firewall rules and the browser
    # policies. Always allowed, session or not (SPEC 7.6). A failure here must
    # not abort the removal: a package that cannot be uninstalled is worse
    # than one that leaves a file behind, and anything that could break
    # networking lives in /run and is gone at the next boot anyway.
    if command -v anchor-blockerd >/dev/null 2>&1; then
      anchor-blockerd --restore || \
        echo "anchor: some changes could not be undone; a reboot clears the rest" >&2
    fi
    ;;
esac

#DEBHELPER#
exit 0
