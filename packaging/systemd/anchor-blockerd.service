[Unit]
Description=Anchor blocker
Documentation=https://github.com/pablofernandezrios/anchor
After=anchord.service network-pre.target
Wants=network-pre.target
BindsTo=anchord.service

[Service]
Type=simple
ExecStart=/usr/bin/anchor-blockerd
Restart=always
RestartSec=1
StartLimitIntervalSec=0

RuntimeDirectory=anchor
StateDirectory=anchor

# The blocker owns the resolver, the nftables table and the browser policies,
# so it needs network administration and the ability to write policy files.
# Everything else is closed off.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_KILL CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
