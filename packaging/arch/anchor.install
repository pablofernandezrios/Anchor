post_install() {
  cat <<'MSG'
Anchor is installed but not yet configured.

Tell it which user may give it orders, then start it:

  sudo sed -i "s/^owner_uid = .*/owner_uid = $(id -u)/" /etc/anchor/anchor.toml
  sudo systemctl enable --now anchord anchor-blockerd
  systemctl --user enable --now anchor-agent

Then check everything is in place:

  anchor doctor
MSG
}

pre_remove() {
  # Removal must restore the system, active session or not (SPEC 7.6). The
  # runtime drop-ins would otherwise refuse the stop.
  rm -f /run/systemd/system/anchord.service.d/anchor-session.conf
  rm -f /run/systemd/system/anchor-blockerd.service.d/anchor-session.conf
  systemctl daemon-reload || true
  # Milestone 2 adds the DNS, nftables and browser-policy restoration here.
}
